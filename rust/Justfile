set positional-arguments

export CARGO := env("CARGO", "cargo")
export FLARE_BOLTFFI := justfile_directory() / "target/tools/bin/boltffi" + if os() == "windows" { ".exe" } else { "" }
export FLARE_WASM_BINDGEN := justfile_directory() / "target/tools/bin/wasm-bindgen" + if os() == "windows" { ".exe" } else { "" }

default:
    @just --list

# Install the CLI version matching Cargo.toml into this workspace.
tools:
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET TVOS_DEPLOYMENT_TARGET WATCHOS_DEPLOYMENT_TARGET XROS_DEPLOYMENT_TARGET
    if [[ "$("$FLARE_BOLTFFI" --version 2>/dev/null || true)" != "boltffi 0.32.1" ]]; then
        "$CARGO" install boltffi_cli --version 0.32.1 --locked --force --root target/tools
    fi

# Each shell generates only its own types and serialization runtime.
typegen language output:
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET TVOS_DEPLOYMENT_TARGET WATCHOS_DEPLOYMENT_TARGET XROS_DEPLOYMENT_TARGET
    host=$("$CARGO" -vV | sed -n 's/^host: //p')
    test -n "$host"
    "$CARGO" run --locked --package flare-core --bin codegen --features codegen --target "$host" -- "$1" "$2"

swift-bindings output="target/apple-bindings": tools (typegen "swift" (output / "types"))
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET TVOS_DEPLOYMENT_TARGET WATCHOS_DEPLOYMENT_TARGET XROS_DEPLOYMENT_TARGET
    output=$(cd "$1" && pwd)
    cd crates/flare-ffi
    "$FLARE_BOLTFFI" --cargo-arg=--locked generate swift --deny-skipped --output "$output/ffi"
    python3 ../../scripts/fix-swift-initialization.py "$output/ffi/FlareFfiBoltFFI.swift"
    cat "$output/types/Initialization.swift" >> "$output/ffi/FlareFfiBoltFFI.swift"
    cp FlareRustFFI.modulemap "$output/ffi/module.modulemap"

# Android's BoltFFI pack step generates Kotlin/JNI bindings and native libraries.
android-types: tools (typegen "kotlin" "target/android/types")

# Match the wasm-bindgen version in Cargo.lock.
web-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$("$FLARE_WASM_BINDGEN" --version 2>/dev/null || true)" != "wasm-bindgen 0.2.130" ]]; then
        "$CARGO" install wasm-bindgen-cli --version 0.2.130 --locked --root target/tools
    fi

# Browser ES module and TypeScript declarations for the application entry point.
web-bindings output="target/web": web-tools (database-web (output / "database"))
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET TVOS_DEPLOYMENT_TARGET WATCHOS_DEPLOYMENT_TARGET XROS_DEPLOYMENT_TARGET
    host=$(rustc -vV | sed -n 's/^host: //p')
    export AR_wasm32_unknown_unknown="${AR_wasm32_unknown_unknown:-$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-ar}"
    "$CARGO" build --locked --package flare-ffi --lib --target wasm32-unknown-unknown --release
    target_dir="${CARGO_TARGET_DIR:-target}"
    "$FLARE_WASM_BINDGEN" --target web --out-dir "$1" --out-name flare "$target_dir/wasm32-unknown-unknown/release/flare_ffi.wasm"

# Internal SQLite worker assets, separate from platform ViewModel bindings.
database-web output="target/database-web": web-tools
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET
    host=$(rustc -vV | sed -n 's/^host: //p')
    export AR_wasm32_unknown_unknown="${AR_wasm32_unknown_unknown:-$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-ar}"
    command -v "$AR_wasm32_unknown_unknown" >/dev/null || { echo 'Install rustup component add llvm-tools-preview, or set AR_wasm32_unknown_unknown to llvm-ar'; exit 1; }
    "$CARGO" build --locked --package flare-database --lib --target wasm32-unknown-unknown --release
    target_dir="${CARGO_TARGET_DIR:-target}"
    "$FLARE_WASM_BINDGEN" --target web --out-dir "$1" --out-name flare_database "$target_dir/wasm32-unknown-unknown/release/flare_database.wasm"
    cp crates/flare-database/web/worker.js "$1/worker.js"

# Uses a test-only Rust client; no database functions enter the production FFI.
database-web-test: (database-web "target/database-web")
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET
    host=$(rustc -vV | sed -n 's/^host: //p')
    export AR_wasm32_unknown_unknown="${AR_wasm32_unknown_unknown:-$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-ar}"
    "$CARGO" build --locked --package flare-database --example web_client --target wasm32-unknown-unknown --release
    target_dir="${CARGO_TARGET_DIR:-target}"
    "$FLARE_WASM_BINDGEN" --target web --out-dir target/database-web --out-name flare_database_client "$target_dir/wasm32-unknown-unknown/release/examples/web_client.wasm"
    node crates/flare-database/tests/web.mjs target/database-web

# Runs the real Rust startup and browser export against bundled database workers.
application-web-test: (database-web "target/database-web")
    #!/usr/bin/env bash
    set -euo pipefail
    unset SDKROOT IPHONEOS_DEPLOYMENT_TARGET MACOSX_DEPLOYMENT_TARGET
    host=$(rustc -vV | sed -n 's/^host: //p')
    export AR_wasm32_unknown_unknown="${AR_wasm32_unknown_unknown:-$(rustc --print sysroot)/lib/rustlib/$host/bin/llvm-ar}"
    "$CARGO" test --locked --package flare-core --package flare-ffi --tests --target wasm32-unknown-unknown --no-run --message-format=json > target/application-web-tests.jsonl
    node tests/application-web.mjs target/application-web-tests.jsonl
